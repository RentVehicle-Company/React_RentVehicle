VITE_CURRENCY=$
VITE_API_URL=https://spring-rentvehicle.onrender.com/api
# ---- Google login (optional feature flag) ----
# Enable the "Continue with Google" button AND provide a client ID:
#   VITE_ENABLE_GOOGLE_LOGIN=true
#   VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# Create an OAuth client ID (Web application) at https://console.cloud.google.com
# and add this app's origin (e.g. http://localhost:5173) to the client's
# "Authorized JavaScript origins". Without the flag the button shows
# "Google sign-in coming soon" instead of erroring.
# VITE_ENABLE_GOOGLE_LOGIN=true
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com